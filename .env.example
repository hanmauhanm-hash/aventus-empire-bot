# ========================================================
# 🏰 AVENTUS EMPIRE BOT - CONFIGURATION ENVIRONMENT
# ========================================================

# [REQUIRED] Discord Bot Token & Application Client ID
# Obtain from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here

# [OPTIONAL] Guild ID for instant development slash command reload
# Leave empty for global slash commands
GUILD_ID=

# [RECOMMENDED] Puter.js AI Auth Token
# Get free token from https://puter.com/dashboard
PUTER_AUTH_TOKEN=your_puter_auth_token_here
PUTER_MODEL=claude-3-5-sonnet

# [CONFIG] Lifeboat Server Settings
DEFAULT_BEDROCK_IP=play.lbsg.net
DEFAULT_BEDROCK_PORT=19132
